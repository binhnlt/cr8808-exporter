# Copy to .env and fill in.  .env is git-ignored.
MODEM_URL=http://192.168.31.1
MODEM_PASSWORD=your-router-admin-password

# Optional: reach the router through a proxy (socks5h:// resolves DNS via the proxy)
# MODEM_PROXY=socks5://user:pass@proxy-host:1080

# Optional overrides (defaults shown):
# MODEM_NAME=                      # value of the `modem` label (default: host from MODEM_URL)
# MODEM_USERNAME=admin             # Xiaomi firmwares only have `admin`
# DRIVER=auto                      # auto | miwifi
# LISTEN_PORT=9878
# SCRAPE_TIMEOUT=10                # per HTTP request
# CACHE_SECONDS=30
# SLOW_REFRESH_SECONDS=300         # how often settings (Wi-Fi config, firewall, DHCP...) are re-read
# CLIENT_METRICS=true              # per-client (per-MAC) traffic metrics
# VERIFY_TLS=false
# LOGOUT_AFTER_SCRAPE=false        # true = new login every scrape
# LOGIN_BACKOFF_SECONDS=300
# LOG_LEVEL=INFO
